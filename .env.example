# Copy to .env and fill in. Every value here is free to obtain.

# Script writer. "fake" needs no key and writes a fixed sample story (for offline tests).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Any OpenAI-compatible endpoint (Groq, OpenRouter) when LLM_PROVIDER=openai
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Voice. kokoro runs locally on CPU; flite is ffmpeg's built-in robotic voice (no download).
TTS_PROVIDER=kokoro
KOKORO_VOICE=am_michael

# Caption timing. whisper runs locally on CPU; proportional needs no model.
ALIGN_PROVIDER=whisper

# Scene video. placeholder draws moving gradients (no AI) so the rest can be tested.
VIDEO_PROVIDER=placeholder
# HF_TOKEN=

OUTPUT_DIR=output
PORT=3000
