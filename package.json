{
  "name": "story-shorts",
  "version": "0.1.0",
  "private": true,
  "description": "Topic in, narrated vertical AI story short out. Free backends only.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "story-shorts": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "cli": "node dist/cli/main.js",
    "generate": "node dist/cli/main.js generate",
    "benchmark": "node dist/cli/main.js benchmark",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "commander": "^15.1.0",
    "kokoro-js": "^1.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
